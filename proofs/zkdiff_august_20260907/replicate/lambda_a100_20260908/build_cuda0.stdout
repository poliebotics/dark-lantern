CUDA=0 features=<none> CARGO_NET_OFFLINE=true LC_ALL=C RUSTFLAGS=<unset> CARGO_HOME=[cargo home] CARGO_BUILD_JOBS=<default> SP1_CIRCUIT_VERSION_env=<unset>
guest remap: --remap-path-prefix $CARGO_HOME=/cargo and [package copy]/source=/g2 (script/build.rs); guest --locked
