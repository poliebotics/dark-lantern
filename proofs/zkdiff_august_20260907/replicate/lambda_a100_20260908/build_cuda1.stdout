date_utc=20260908T172259Z host=replication-box kernel=Linux 6.8.0-60-generic x86_64 glibc=ldd (Ubuntu GLIBC 2.35-0ubuntu3.10) 2.35
cargo_config=[package copy]/source/armc-relation/.cargo/config.toml ([net]offline = true)
== command
cd [package copy]/source/armc-relation/script && touch ../program/src/main.rs && cargo build --release --offline --locked --features cuda --bin zkdiff-execute --bin zkdiff-ceremony --bin zkdiff-batch --bin zkdiff-verify
== environment
CUDA=1 features=--features cuda CARGO_NET_OFFLINE=true LC_ALL=C RUSTFLAGS=<unset> CARGO_HOME=[cargo home] CARGO_BUILD_JOBS=<default> SP1_CIRCUIT_VERSION_env=<unset>
guest remap: --remap-path-prefix $CARGO_HOME=/cargo and [package copy]/source=/g2 (script/build.rs); guest --locked
